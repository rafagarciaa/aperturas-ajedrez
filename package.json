{
  "name": "ajedrez-aperturas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Entrena aperturas de ajedrez contra Stockfish (escritorio y móvil)",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:android": "tsc --noEmit && vite build --mode android && cap sync android",
    "openings": "node scripts/build-openings.mjs",
    "postinstall": "node scripts/copy-engine.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@lichess-org/chessground": "^10.5.0",
    "chess.js": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
